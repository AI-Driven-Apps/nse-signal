{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi",
      "entrypoint": "app.web.app:app",
      "functions": { "app/web/app.py": { "excludeFiles": "{tests/**,**/test_*.py,**/*.ipynb,data/**,notebooks/**,docs/**,.git/**}" } }
    },
    "golden_master": {
      "root": "golden_master",
      "runtime": "python",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
