# Copy to .env and fill in. Do NOT commit .env (it holds your webhook secret).

# Discord webhook for signal alerts (required for notifications).
# Discord → server → channel settings → Integrations → Webhooks → New Webhook → Copy URL
DISCORD_WEBHOOK_URL=

# Default strategy on first boot: sma_cross | rsi_reversion
# (After first boot the active strategy is read from the settings table.)
DEFAULT_STRATEGY=sma_cross

# Days of history to backfill / keep and re-fetch each ingest.
BACKFILL_DAYS=730

# Minimum bars before a strategy emits signals.
MIN_BARS=120

# Emit signals for position flips within this many days of the latest bar,
# so a missed/failed nightly run is caught up on the next run.
SIGNAL_LOOKBACK_DAYS=7

# Database. Default is SQLite on the mounted volume.
# Phase 3: swap to Supabase Postgres (also add psycopg2-binary to requirements):
# DATABASE_URL=postgresql+psycopg2://user:pass@db.xxx.supabase.co:5432/postgres
DATABASE_URL=sqlite:////data/backstage.db

# Scheduler timezone.
TZ=Asia/Kolkata
