{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "fastapi"
    },
    "golden_master": {
      "root": "golden_master",
      "runtime": "python",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": { "service": "app" } }
  ]
}
